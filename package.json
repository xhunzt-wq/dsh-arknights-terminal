  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "assets", "lib", "preview", "src", "scripts", "cordis.patch.yml",
    "skin.json", "LICENSE", "NOTICE", "README.md"
  ]
}
